rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'google.com' ||
        request.auth.token.email == 'bmc21ict@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.size() > 0)
      );
    }

    function isValidStudent(data) {
      return data.keys().hasAll(['studentCode', 'lastName', 'firstName', 'gender', 'values'])
        && data.keys().hasOnly(['studentCode', 'lastName', 'firstName', 'gender', 'grade', 'photoUrl', 'values', 'createdAt', 'updatedAt', 'lastModifiedBy', 'lastModifiedAt', 'createdBy'])
        && data.studentCode is string && data.studentCode.size() > 0 && data.studentCode.size() <= 60
        && data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 120
        && data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 120
        && data.gender is string && data.gender.size() > 0 && data.gender.size() <= 30
        && (!('grade' in data) || (data.grade is string && data.grade.size() <= 60))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 65536))
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 160))
        && (!('lastModifiedBy' in data) || (data.lastModifiedBy is string && data.lastModifiedBy.size() <= 160))
        && (!('lastModifiedAt' in data) || data.lastModifiedAt is timestamp)
        && data.values is list && data.values.size() > 0 && data.values.size() <= 95
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    match /students/{studentId} {
      allow get, list: if true;
      allow create: if isVerifiedUser()
        && isValidId(studentId)
        && isValidStudent(incoming())
        && (incoming().createdAt == request.time || incoming().createdAt is timestamp);
      allow update: if isVerifiedUser()
        && isValidId(studentId)
        && isValidStudent(incoming())
        && (!('createdAt' in existing()) || !('createdAt' in incoming()) || incoming().createdAt == existing().createdAt)
        && incoming().diff(existing()).affectedKeys().hasOnly(['studentCode', 'lastName', 'firstName', 'gender', 'grade', 'photoUrl', 'values', 'updatedAt', 'lastModifiedBy', 'lastModifiedAt', 'createdBy'])
        && (
          (('updatedAt' in incoming()) && (incoming().updatedAt == request.time || incoming().updatedAt is timestamp)) ||
          (('lastModifiedAt' in incoming()) && (incoming().lastModifiedAt == request.time || incoming().lastModifiedAt is timestamp))
        );
      allow delete: if isVerifiedUser()
        && isValidId(studentId);
    }

    match /test/{testId} {
      allow get: if true;
    }
  }
}
